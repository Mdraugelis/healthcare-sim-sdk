  "study": {
    "id": "hong_2020_shield_rt_during_treatment",
    "title": "SHIELD-RT: exposed development pilot",
    "citation": "https://pubmed.ncbi.nlm.nih.gov/32886536/",
    "population": "Already selected high-risk RT/CRT courses; screening model performance is not evaluated.",
    "assignment_unit": "RT course, fixed randomized arm sizes; repeated patients treated as independent (approximation).",
    "outcome": "At least one acute-care event during the treatment course.",
    "denominator": "All registered high-risk courses in each randomized arm.",
    "horizon": "Whole radiation-treatment course; one normalized episode, no invented six-week duration.",
    "estimand": "Intervention minus control course-level acute-care risk difference.",
    "analysis": "Independent-arm empirical risk difference; synthetic trial sampling plus independent assumed parameter uncertainty.",
    "limitations": "Outcome-exposed development only. Independent uniform parameter assumptions are illustrative, not clinical evidence. Conditions on realized arm sizes. Does not model score selection, visits, course durations, repeated-patient clustering, or adjudication."
